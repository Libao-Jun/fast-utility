{
  "name": "fast-utility",
  "version": "1.0.0",
  "description": "前端常用工具函数宝库（fn = function + vault = 宝库）/ A lightweight, zero-dependency collection of frontend utility functions. 轻量、零依赖、支持 Tree-shaking 的 JavaScript / TypeScript 常用工具函数库",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.js",
    "test": "vitest"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "fast-utility",
    "utils",
    "utility",
    "function",
    "collection",
    "array",
    "browser",
    "math"
  ],
  "author": "newborn_calf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Libao-Jun/fnvault"
  },
  "homepage": "https://github.com/Libao-Jun/fnvault#readme",
  "bugs": {
    "url": "https://github.com/Libao-Jun/fnvault/issues"
  },
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "rolldown": "^1.0.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}