{
  "name": "fast-utility",
  "version": "1.0.1",
  "description": "轻量、高效的 JS / TS 工具函数库，零依赖、Tree-shaking 友好，浏览器与 Node 通用。",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.min.js",
  "jsdelivr": "dist/index.global.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && rolldown -c rolldown.config.js",
    "test": "vitest"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "fast-utility",
    "utils",
    "utility",
    "function",
    "collection",
    "array",
    "browser",
    "math"
  ],
  "author": "newborn_calf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Libao-Jun/fast-utility.git"
  },
  "homepage": "https://github.com/Libao-Jun/fast-utility#readme",
  "bugs": {
    "url": "https://github.com/Libao-Jun/fast-utility/issues"
  },
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.15",
    "rolldown-plugin-dts": "^0.28.8",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}